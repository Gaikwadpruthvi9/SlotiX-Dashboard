{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/select", "destination": "/frontend/select.html" },
    { "source": "/select.html", "destination": "/frontend/select.html" },
    { "source": "/index", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/frontend", "destination": "/frontend/index.html" },
    { "source": "/frontend/", "destination": "/frontend/index.html" },
    { "source": "/frontend/login", "destination": "/frontend/login.html" },
    { "source": "/frontend/login.html", "destination": "/frontend/login.html" },
    { "source": "/frontend/select", "destination": "/frontend/select.html" },
    { "source": "/frontend/select.html", "destination": "/frontend/select.html" },
    { "source": "/frontend/index", "destination": "/frontend/index.html" },
    { "source": "/frontend/index.html", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
